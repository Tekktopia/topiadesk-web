# ── Service ────────────────────────────────────────────────────────────────
PORT=4040
NODE_ENV=development
LOG_LEVEL=info

# Topiadesk API base — where this service writes back reconciliation results.
TOPIADESK_API_URL=http://localhost:3000/api
TOPIADESK_API_TOKEN=replace-me

# ── Microsoft Entra ID / Intune ────────────────────────────────────────────
# Single multi-tenant app registration in Topiadesk's own Azure tenant.
# Customers' tenant IDs come in via per-tenant connection records, not here.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-me
# clientState we expect inside every Graph webhook payload (HMAC-like shared secret)
ENTRA_WEBHOOK_CLIENT_STATE=replace-me-with-a-32-byte-random-string

# ── Google Workspace ───────────────────────────────────────────────────────
# Path to service-account JSON. Customers grant domain-wide delegation to
# the service-account's client ID; impersonation target is per-customer.
GOOGLE_SERVICE_ACCOUNT_KEY=/secrets/google-sa.json
# Cloud Pub/Sub subscription name used for push notifications
GOOGLE_PUBSUB_TOPIC=projects/topiadesk/topics/device-events
GOOGLE_PUBSUB_AUDIENCE=https://api.topiadesk.com/v1/webhooks/google

# ── Jamf Pro ──────────────────────────────────────────────────────────────
# Per-tenant credentials live in the connection store; this is just the
# HMAC shared secret Jamf signs outgoing webhooks with.
JAMF_WEBHOOK_SECRET=replace-me

# ── Kandji ────────────────────────────────────────────────────────────────
KANDJI_WEBHOOK_BEARER=replace-me

# ── Polling fallback ──────────────────────────────────────────────────────
# How often to call list-devices APIs as a safety net when webhooks miss.
POLL_INTERVAL_SECONDS=600
# How often to refresh Graph subscriptions (Microsoft expires them at ~3 days)
RENEW_INTERVAL_SECONDS=21600
