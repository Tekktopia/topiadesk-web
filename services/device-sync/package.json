{
  "name": "@topiadesk/device-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Asset-register reconciliation service. Receives webhooks from Entra ID / Google Workspace / Intune / Jamf / Kandji, diffs detected devices against Topiadesk's asset register, and writes pending-decision entries into the device-sync inbox.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "start":      "node dist/index.js",
    "build":      "tsc -p .",
    "typecheck":  "tsc -p . --noEmit",
    "lint":       "eslint .",
    "test":       "vitest run"
  },
  "dependencies": {
    "fastify":          "^4.28.1",
    "@fastify/raw-body":"^4.3.0",
    "pino":             "^9.4.0",
    "pino-pretty":      "^11.2.2",
    "zod":              "^3.23.8",
    "undici":           "^6.19.8"
  },
  "devDependencies": {
    "@types/node":      "^22.10.2",
    "tsx":              "^4.19.1",
    "typescript":       "^5.6.3",
    "vitest":           "^2.1.4"
  }
}
